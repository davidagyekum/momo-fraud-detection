{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://momo-fdvs.local/contracts/analysis-result-v1.schema.json",
  "title": "MoMo-FDVS analysis result v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "policy_version",
    "policy_sha256",
    "evidence_mode",
    "status",
    "band",
    "conclusion_status",
    "component_status",
    "legacy_risk_class",
    "score",
    "reasons",
    "missing_signals",
    "limitations",
    "summary",
    "verification",
    "image_evidence",
    "model_status",
    "versions"
  ],
  "properties": {
    "contract_version": {"const": "analysis-result-v1"},
    "policy_version": {"type": "string", "minLength": 1},
    "policy_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "evidence_mode": {
      "enum": ["screenshot_only", "transaction_only", "combined", "inconclusive"]
    },
    "status": {"enum": ["COMPLETED", "PARTIAL"]},
    "band": {"enum": ["low_risk", "medium_risk", "high_risk", "inconclusive"]},
    "conclusion_status": {"enum": ["CONCLUSIVE", "INCONCLUSIVE"]},
    "component_status": {"enum": ["COMPLETE", "DEGRADED"]},
    "legacy_risk_class": {
      "type": ["string", "null"],
      "enum": ["GENUINE", "SUSPICIOUS", "FRAUDULENT", null]
    },
    "score": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "reasons": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/reason"}
    },
    "missing_signals": {
      "type": "array",
      "items": {"$ref": "#/$defs/code"},
      "uniqueItems": true
    },
    "limitations": {
      "type": "array",
      "items": {"$ref": "#/$defs/code"},
      "uniqueItems": true
    },
    "summary": {"type": "string", "minLength": 1},
    "verification": {
      "oneOf": [{"$ref": "#/$defs/verification"}, {"type": "null"}]
    },
    "image_evidence": {"$ref": "#/$defs/imageEvidence"},
    "model_status": {
      "type": "object",
      "additionalProperties": false,
      "required": ["image", "structured"],
      "properties": {
        "image": {"$ref": "#/$defs/modelStatus"},
        "structured": {"$ref": "#/$defs/modelStatus"}
      }
    },
    "versions": {"$ref": "#/$defs/versions"}
  },
  "allOf": [
    {
      "if": {"properties": {"band": {"const": "inconclusive"}}},
      "then": {
        "properties": {
          "status": {"const": "PARTIAL"},
          "legacy_risk_class": {"type": "null"},
          "score": {"type": "null"}
        }
      }
    }
  ],
  "$defs": {
    "code": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{1,63}$"},
    "reason": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "title", "severity"],
      "properties": {
        "code": {"$ref": "#/$defs/code"},
        "title": {"type": "string", "minLength": 1},
        "severity": {"enum": ["INFORMATIONAL", "LOW", "MEDIUM", "HIGH", "CRITICAL"]}
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "label",
        "basis",
        "summary",
        "reference_transaction_id",
        "candidate_method",
        "verifier_version",
        "rule_set_version",
        "field_comparisons",
        "matched_field_count",
        "mismatched_field_count",
        "warnings",
        "disclaimer"
      ],
      "properties": {
        "status": {"enum": ["VERIFIED", "MISMATCH", "UNVERIFIED"]},
        "label": {"type": "string", "minLength": 1},
        "basis": {"const": "STORED_IMPORTED_RECORD"},
        "summary": {"type": "string", "minLength": 1},
        "reference_transaction_id": {"type": ["string", "null"], "format": "uuid"},
        "candidate_method": {"type": "string", "minLength": 1},
        "verifier_version": {"type": "string", "minLength": 1},
        "rule_set_version": {"type": ["string", "null"]},
        "field_comparisons": {"type": "object"},
        "matched_field_count": {"type": "integer", "minimum": 0},
        "mismatched_field_count": {"type": "integer", "minimum": 0},
        "warnings": {
          "type": "array",
          "items": {"$ref": "#/$defs/code"},
          "uniqueItems": true
        },
        "disclaimer": {"type": "string", "minLength": 1}
      }
    },
    "imageEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "algorithm_version",
        "reason_code",
        "classification",
        "tamper_probability",
        "summary",
        "triggered_signals",
        "warnings",
        "policy"
      ],
      "properties": {
        "status": {"enum": ["COMPLETED", "UNAVAILABLE"]},
        "algorithm_version": {"type": ["string", "null"]},
        "reason_code": {
          "oneOf": [{"$ref": "#/$defs/code"}, {"type": "null"}]
        },
        "classification": {"type": "null"},
        "tamper_probability": {"type": "null"},
        "summary": {"type": "string", "minLength": 1},
        "triggered_signals": {
          "type": "array",
          "items": {"$ref": "#/$defs/reason"}
        },
        "warnings": {
          "type": "array",
          "items": {"$ref": "#/$defs/code"},
          "uniqueItems": true
        },
        "policy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "supporting_evidence_only",
            "single_weak_signal_can_classify_fraud"
          ],
          "properties": {
            "supporting_evidence_only": {"const": true},
            "single_weak_signal_can_classify_fraud": {"const": false}
          }
        }
      }
    },
    "modelStatus": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "version", "score", "class", "reason_codes"],
      "properties": {
        "status": {"enum": ["SUCCESS", "UNAVAILABLE", "ERROR"]},
        "version": {"type": ["string", "null"]},
        "score": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "class": {"type": ["string", "null"]},
        "reason_codes": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/code"},
          "uniqueItems": true
        }
      }
    },
    "versions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy",
        "ocr_pipeline",
        "template",
        "image_model",
        "structured_model",
        "rule_set",
        "image_forensics"
      ],
      "properties": {
        "policy": {"type": "string", "minLength": 1},
        "ocr_pipeline": {"type": ["string", "null"]},
        "template": {"type": ["string", "null"]},
        "image_model": {"type": ["string", "null"]},
        "structured_model": {"type": ["string", "null"]},
        "rule_set": {"type": ["string", "null"]},
        "image_forensics": {"type": ["string", "null"]}
      }
    }
  }
}
