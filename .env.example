# -----------------------------------------------------------------------------
# MoMo-FDVS environment contract
# Copy to .env locally. Never commit .env or real secrets.
# -----------------------------------------------------------------------------

# Application
APP_ENV=development
APP_NAME=MoMo-FDVS
APP_VERSION=0.0.0-dev
APP_BUILD_SHA=local
API_CONTRACT_VERSION=1.0.0
LOG_LEVEL=INFO
TRUST_PROXY_HEADERS=false
PUBLIC_API_URL=http://localhost:8000
REQUEST_ID_HEADER=X-Request-ID

# Database
POSTGRES_DB=momo_fdvs
POSTGRES_USER=momo_fdvs
POSTGRES_PASSWORD=momo_fdvs_local_only
POSTGRES_PORT=5432
API_PORT=8000
DATABASE_URL=postgresql+psycopg://momo_fdvs:momo_fdvs_local_only@localhost:5432/momo_fdvs
DATABASE_POOL_SIZE=5
DATABASE_POOL_MAX_OVERFLOW=5
DATABASE_POOL_TIMEOUT_SECONDS=30
DATABASE_STATEMENT_TIMEOUT_MS=30000

# Authentication/session — replace every placeholder outside local development
JWT_ACCESS_SECRET=CHANGE_ME_USE_A_LONG_RANDOM_VALUE
JWT_REFRESH_SECRET=CHANGE_ME_USE_A_DIFFERENT_LONG_RANDOM_VALUE
CSRF_SECRET=CHANGE_ME_USE_A_DIFFERENT_LONG_RANDOM_VALUE
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
PASSWORD_RESET_TTL_MINUTES=30
AUTH_COOKIE_NAME=momo_fdvs_refresh
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=Lax
AUTH_COOKIE_DOMAIN=
AUTH_COOKIE_PATH=/api/v1/auth
SELF_REGISTRATION_ENABLED=true

# Bootstrap — local/controlled environment only
BOOTSTRAP_ADMIN_EMAIL=admin@example.test
BOOTSTRAP_ADMIN_FULL_NAME=Local Demo Administrator
BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_LOCAL_ONLY
BOOTSTRAP_INVESTIGATOR_EMAIL=investigator@example.test
BOOTSTRAP_INVESTIGATOR_FULL_NAME=Local Demo Investigator
BOOTSTRAP_INVESTIGATOR_PASSWORD=CHANGE_ME_LOCAL_ONLY

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8081
CORS_ALLOW_CREDENTIALS=true

# Private object storage
STORAGE_ADAPTER=local
LOCAL_PRIVATE_STORAGE_ROOT=./.local/private-storage
S3_ENDPOINT_URL=
S3_REGION=
S3_BUCKET=
S3_PREFIX=momo-fdvs
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_SERVER_SIDE_ENCRYPTION=AES256
SIGNED_URL_TTL_SECONDS=300

# Upload safety
UPLOAD_MAX_BYTES=10485760
UPLOAD_REQUEST_MAX_BYTES=11534336
UPLOAD_MAX_PIXEL_COUNT=30000000
UPLOAD_MAX_DIMENSION_PX=12000
UPLOAD_MIN_WIDTH_PX=320
UPLOAD_MIN_HEIGHT_PX=320
UPLOAD_ALLOWED_FORMATS=JPEG,PNG,WEBP
UPLOAD_CLIENT_METADATA_MAX_BYTES=4096
UPLOAD_IDEMPOTENCY_TTL_HOURS=24
UPLOAD_NEAR_DUPLICATE_DISTANCE=5
TEMP_PROCESSING_ROOT=./.local/tmp

# OCR
TESSERACT_CMD=tesseract
TESSERACT_LANG=eng
TESSERACT_TIMEOUT_SECONDS=20
OCR_REVIEW_CONFIDENCE_THRESHOLD=0.75
OCR_MAX_VARIANTS=6
OCR_TARGET_MIN_WIDTH_PX=1200
OCR_PIPELINE_VERSION=ocr-pipeline-v1
OCR_PARSER_VERSION=generic-parser-v1
OCR_FIELD_SCHEMA_VERSION=ocr-fields-v1
RATE_LIMIT_OCR=10 per hour
RATE_LIMIT_OCR_REVIEW=60 per minute

# Analysis worker
WORKER_ID=
WORKER_POLL_SECONDS=2
WORKER_HEARTBEAT_SECONDS=15
WORKER_STALE_AFTER_SECONDS=120
WORKER_MAX_ATTEMPTS=3
WORKER_CONCURRENCY=1
ANALYSIS_PER_USER_CONCURRENT_LIMIT=2

# Models/artifacts
MODEL_ARTIFACT_ROOT=./.local/model-artifacts
STRUCTURED_MODEL_ROOT=./.local/model-artifacts/structured
STRUCTURED_MODEL_MAX_BYTES=268435456
IMAGE_MODEL_ROOT=./.local/model-artifacts/image
IMAGE_MODEL_MAX_BYTES=1073741824
STRUCTURED_MODEL_REQUIRED=false
IMAGE_MODEL_REQUIRED=false
MODEL_HASH_VERIFICATION=true
ML_RANDOM_SEED=42

# Preliminary risk defaults — database active rule set supersedes these
RISK_WEIGHT_IMAGE=0.40
RISK_WEIGHT_STRUCTURED=0.40
RISK_WEIGHT_RULES=0.20
RISK_THRESHOLD_SUSPICIOUS=35
RISK_THRESHOLD_FRAUDULENT=70
RULE_SCORE_SCALE=1.0

# Reference verification
REFERENCE_AMOUNT_TOLERANCE=0.00
REFERENCE_TIMESTAMP_TOLERANCE_MINUTES=30
REFERENCE_NAME_SIMILARITY_THRESHOLD=0.90
REFERENCE_IMPORT_MAX_BYTES=10485760
REFERENCE_IMPORT_MAX_ROWS=100000
REFERENCE_IMPORT_PREVIEW_ERRORS=100
RATE_LIMIT_REFERENCE_IMPORT=20 per hour
VERIFIER_VERSION=stored-reference-verifier-v1

# Deterministic image evidence (supporting evidence only; no ML inference)
IMAGE_FORENSICS_VERSION=deterministic-image-forensics-v1
IMAGE_FORENSICS_MIN_DIMENSION_PX=128
IMAGE_FORENSICS_JPEG_QUALITY=90
IMAGE_FORENSICS_ELA_REGIONAL_CV_THRESHOLD=0.80
IMAGE_FORENSICS_NOISE_REGIONAL_CV_THRESHOLD=0.65
IMAGE_FORENSICS_MIN_QUALITY_SCORE=0.15
IMAGE_FORENSICS_BASELINE_THRESHOLD=0.18
IMAGE_FORENSICS_HEIGHT_CV_THRESHOLD=0.45
IMAGE_FORENSICS_EDGE_MARGIN_THRESHOLD=0.01
IMAGE_FORENSICS_MIN_ASPECT_RATIO=0.25
IMAGE_FORENSICS_MAX_ASPECT_RATIO=2.00

# Reports and masking
REPORT_RETENTION_DAYS=30
MASK_PHONE_VISIBLE_SUFFIX=4
MASK_REFERENCE_VISIBLE_PREFIX=4
MASK_REFERENCE_VISIBLE_SUFFIX=2

# Notifications
NOTIFICATION_ADAPTER=in_app
EMAIL_PROVIDER=
EMAIL_API_KEY=
EMAIL_FROM=
PUSH_PROVIDER=
PUSH_API_KEY=

# Rate limits (examples; final syntax depends on limiter library)
RATE_LIMIT_LOGIN=5 per minute
RATE_LIMIT_REFRESH=10 per minute
RATE_LIMIT_REGISTRATION=5 per hour
RATE_LIMIT_PASSWORD_RESET=5 per hour
RATE_LIMIT_UPLOAD=30 per hour
RATE_LIMIT_RECEIPT_READ=60 per minute
RATE_LIMIT_ANALYSIS=20 per hour
RATE_LIMIT_EXPORT=10 per hour

# Observability
ERROR_MONITORING_DSN=
METRICS_ENABLED=false
PII_LOG_REDACTION=true

# Frontend public variables
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_APP_ENV=development
VITE_APP_VERSION=0.0.0-dev

# Expo public variables — public by definition; never put secrets here
EXPO_PUBLIC_API_URL=http://192.168.1.10:8000
EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_APP_VERSION=0.0.0-dev
