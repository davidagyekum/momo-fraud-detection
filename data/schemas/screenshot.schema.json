{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://momo-fdvs.local/schemas/screenshot-v1.json",
  "title": "Governed screenshot record v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["image_id", "source_group_id", "parent_image_id", "provenance", "participant_id_hash", "provider_family", "template_family", "template_version", "capture_channel", "device_family", "os_family", "resolution", "theme", "image_class", "tamper_target", "tamper_method", "benign_transform", "mask_path", "transcript_path", "ground_truth_fields_path", "split", "consent_scope", "permission_reference", "sha256"],
  "properties": {
    "image_id": {"type": "string", "pattern": "^FIXTURE_[A-Z0-9_-]+$"},
    "source_group_id": {"type": "string", "minLength": 1},
    "parent_image_id": {"type": ["string", "null"]},
    "provenance": {"enum": ["controlled_real", "synthetic_template", "stfd", "fsts"]},
    "participant_id_hash": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "provider_family": {"type": "string", "minLength": 1},
    "template_family": {"type": "string", "minLength": 1},
    "template_version": {"type": "string", "minLength": 1},
    "capture_channel": {"enum": ["sms", "notification", "app_receipt", "history", "other"]},
    "device_family": {"type": "string", "minLength": 1},
    "os_family": {"enum": ["android", "ios", "other"]},
    "resolution": {"type": "array", "prefixItems": [{"type": "integer", "minimum": 1}, {"type": "integer", "minimum": 1}], "minItems": 2, "maxItems": 2},
    "theme": {"enum": ["light", "dark", "unknown"]},
    "image_class": {"enum": ["unaltered", "tampered"]},
    "tamper_target": {"enum": ["none", "amount", "recipient", "reference", "datetime", "status", "header", "multi"]},
    "tamper_method": {"enum": ["none", "replacement", "splicing", "removal_insertion", "copy_move", "inpainting", "composite"]},
    "benign_transform": {"enum": ["none", "jpeg", "webp", "resize", "crop", "blur", "screen_photo", "other"]},
    "mask_path": {"type": ["string", "null"]},
    "transcript_path": {"type": "string", "pattern": "^fixtures/"},
    "ground_truth_fields_path": {"type": "string", "pattern": "^fixtures/"},
    "split": {"enum": ["train", "validation", "test"]},
    "consent_scope": {"enum": ["internal_only", "release_approved", "synthetic_not_applicable"]},
    "permission_reference": {"type": "string", "minLength": 1},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
