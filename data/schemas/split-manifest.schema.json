{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://momo-fdvs.local/schemas/split-manifest-v1.json",
  "title": "Frozen source-group split manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "dataset_id", "seed", "frozen", "manifest_sha256", "groups"],
  "properties": {
    "schema_version": {"const": "split-manifest-v1"},
    "dataset_id": {"type": "string", "minLength": 1},
    "seed": {"type": "integer", "minimum": 0},
    "frozen": {"const": true},
    "manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "groups": {
      "type": "object",
      "additionalProperties": false,
      "required": ["train", "validation", "test"],
      "properties": {
        "train": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
        "validation": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
        "test": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true}
      }
    }
  }
}
