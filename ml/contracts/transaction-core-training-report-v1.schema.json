{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://momo-fdvs.local/ml/contracts/transaction-core-training-report-v1.json",
  "title": "MoMo-FDVS PR15 transaction-core training report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "model_name",
    "model_version",
    "dataset_id",
    "source_sha256",
    "build_report_sha256",
    "split_manifest_sha256",
    "preprocessor_sha256",
    "config_sha256",
    "training_commit_sha",
    "runtime_inventory",
    "candidates",
    "stability",
    "selection",
    "calibration",
    "thresholds",
    "external_tuning_evaluations",
    "artifact",
    "explainability_reason_categories",
    "locked_test_sealed",
    "locked_test_accessed_for_decisions",
    "full_training_executed",
    "final_evaluation_executed",
    "not_real_world_probability",
    "promotable",
    "limitations"
  ],
  "properties": {
    "schema_version": {"const": "transaction-core-training-report-v1"},
    "model_name": {"const": "transaction_core"},
    "model_version": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,99}$"},
    "dataset_id": {"enum": ["paysim", "momtsim-v1", "momtsim-v2"]},
    "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "build_report_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "split_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "preprocessor_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "config_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "training_commit_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "runtime_inventory": {"type": "object"},
    "candidates": {"type": "array", "minItems": 2},
    "stability": {"type": "array", "minItems": 3, "maxItems": 3},
    "selection": {"type": "object"},
    "calibration": {"type": "object"},
    "thresholds": {"type": "object"},
    "external_tuning_evaluations": {"type": "array"},
    "artifact": {"type": "object"},
    "explainability_reason_categories": {
      "type": "array",
      "items": {"enum": ["unusual_amount", "high_velocity", "new_recipient", "sequence_anomaly"]},
      "uniqueItems": true
    },
    "locked_test_sealed": {"const": true},
    "locked_test_accessed_for_decisions": {"const": false},
    "full_training_executed": {"const": true},
    "final_evaluation_executed": {"const": false},
    "not_real_world_probability": {"const": true},
    "promotable": {"const": false},
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string"}}
  }
}
