{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://momo-fdvs.local/contracts/dataset-registration-manifest-v1.schema.json",
  "title": "MoMo-FDVS content-addressed dataset registration manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "dataset_id", "dataset_version", "status", "created_at", "source_kind", "source_sha256", "source_size_bytes", "file_count", "inventory_sha256", "request_sha256", "validation_spec_sha256", "validation_summary", "quarantine_reasons", "network_acquisition_executed", "source_bytes_committed", "promotable_for_training"],
  "properties": {
    "schema_version": {"const": "dataset-registration-manifest-v1"},
    "dataset_id": {"type": "string", "minLength": 1},
    "dataset_version": {"type": "string", "minLength": 1},
    "status": {"enum": ["registered", "quarantined"]},
    "created_at": {"type": "string", "format": "date-time"},
    "source_kind": {"enum": ["file", "directory"]},
    "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_size_bytes": {"type": "integer", "minimum": 1},
    "file_count": {"type": "integer", "minimum": 1},
    "inventory_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "request_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "validation_spec_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "validation_summary": {"type": "object"},
    "quarantine_reasons": {"type": "array", "items": {"type": "string"}},
    "network_acquisition_executed": {"const": false},
    "source_bytes_committed": {"const": false},
    "promotable_for_training": {"const": false}
  }
}
