{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://momo-fdvs.local/contracts/transaction-deduplication-request-v1.schema.json",
  "title": "MoMo-FDVS governed exact-row deduplication request",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "dataset_id", "source_path", "expected_source_sha256", "expected_source_size_bytes", "source_dataset_version", "derived_dataset_version", "required_columns", "label_column", "positive_values", "created_at", "decision_reference", "transformation_version", "acknowledgements"],
  "properties": {
    "schema_version": {"const": "transaction-deduplication-request-v1"},
    "dataset_id": {"type": "string", "minLength": 1},
    "source_path": {"type": "string", "minLength": 1},
    "expected_source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "expected_source_size_bytes": {"type": "integer", "minimum": 1},
    "source_dataset_version": {"type": "string", "minLength": 1},
    "derived_dataset_version": {"type": "string", "minLength": 1},
    "required_columns": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "label_column": {"type": "string", "minLength": 1},
    "positive_values": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "created_at": {"type": "string", "format": "date-time"},
    "decision_reference": {"const": "ADR-027"},
    "transformation_version": {"const": "exact-row-first-occurrence-v1"},
    "acknowledgements": {
      "type": "object",
      "additionalProperties": false,
      "required": ["preserve_source", "private_output", "no_splits", "no_training"],
      "properties": {
        "preserve_source": {"const": true},
        "private_output": {"const": true},
        "no_splits": {"const": true},
        "no_training": {"const": true}
      }
    }
  }
}
